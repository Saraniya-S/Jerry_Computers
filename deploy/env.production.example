# Production settings for the VPS. On the server: cp deploy/env.production.example .env.local
# then fill in every value. Never commit the filled-in file.

# Database (deploy/docker-compose.yml). Make up a long random password; it only lives here.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://jerry:SAME_PASSWORD_AS_ABOVE@127.0.0.1:5432/jerry_computers

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Your site's address, with https and no trailing slash.
APP_URL=https://yourdomain.com

# Real email (sign-in codes, password resets, invoices). Gmail example: use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Jerry Computers <you@gmail.com>"

# Google sign-in: add https://yourdomain.com/api/auth/google/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SUPER_ADMIN_EMAIL=jerrycomputers18@gmail.com

# Razorpay: live keys once the account is activated (rzp_live_…), test keys until then.
# Webhook URL: https://yourdomain.com/api/payments/razorpay/webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Where uploaded product photos are kept (default: the app's uploads folder).
# UPLOAD_DIR=/home/jerry/app/uploads
