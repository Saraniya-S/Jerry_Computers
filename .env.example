# Copy to .env.local and fill in. Values below match docker-compose.yml for local development.

# PostgreSQL
DATABASE_URL=postgres://jerry:jerry@localhost:5433/jerry_computers

# Signs one-time codes. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Public origin of the site, used for Google's redirect URL.
APP_URL=http://localhost:3000

# SMTP for verification emails. Mailpit (docker-compose) accepts anything on port 1025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Jerry Computers <no-reply@jerrycomputers.local>"

# Google sign-in for customers (optional). Create an OAuth client at
# https://console.cloud.google.com/apis/credentials with the redirect URI
# {APP_URL}/api/auth/google/callback. Leave blank to hide Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Owner account created by: npm run admin:create
SUPER_ADMIN_EMAIL=jerrycomputers18@gmail.com

# Razorpay (online payments). Dashboard → Account & Settings → API keys. Use rzp_test_… keys until
# the account is activated. Leave empty to hide online payment at checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → Add: URL {APP_URL}/api/payments/razorpay/webhook, a secret you choose (put it
# here), events: payment.captured, payment.failed, order.paid, refund.processed, refund.failed.
RAZORPAY_WEBHOOK_SECRET=
